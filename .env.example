# ── CoOps server ─────────────────────────────────────────────────────────────
# Everything is optional: with no keys set, the server runs fully deterministic.

PORT=8080
COOPS_DATA_DIR=./server/data
COOPS_ALLOW_DEV_EMIT=0
COOPS_ENABLE_A2A=0

# Google AI Studio key — activates GeminiBrain (function calling), department
# memory reads/writes, guardrail inspection, and dry-run workspace tools.
GEMINI_API_KEY=
COOPS_GEMINI_MODEL=gemini-2.0-flash

# Publication pipeline — allow-listed local discovery, Cloud Storage handoff and
# YouTube upload. Discovery reads nothing outside COOPS_LOCAL_ROOTS, and the
# YouTube step requires a human approval bound to the staged file's checksum.
COOPS_LOCAL_ROOTS=
COOPS_CONNECTOR_ID=
COOPS_GCS_BUCKET=
